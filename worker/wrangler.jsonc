{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "aurora-music",
    "main": "src/index.js",
    "compatibility_date": "2026-11-11",

    "assets": {
        // Generated by `npm run prepare-assets`: the web app (../dist) + the admin page
        "directory": "./public",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        // Only these paths run the Worker; everything else is a static file (free and unlimited)
        "run_worker_first": [
            "/api/*",
            "/jf/*",
            "/admin/api/*",
            "/branding/*",
            "/favicon.ico",
            "/favicon-96x96.png",
            "/apple-touch-icon.png"
        ]
    },

    // Logos, icon and login background. Create it once: npx wrangler r2 bucket create aurora-branding
    "r2_buckets": [{ "binding": "BRANDING", "bucket_name": "aurora-branding" }],

    "vars": {
        "ADMIN_USER": "admin"
    }

    // Secrets (never in this file):
    //   npx wrangler secret put ADMIN_PASSWORD   panel password
    //   npx wrangler secret put SESSION_SECRET   long random string (signs/encrypts sessions)
    //   npx wrangler secret put DATABASE_URL     Neon connection string
    //
    // Optional variables: LOGIN_MAX_FAILURES, LOGIN_WINDOW_MS, FRAME_ANCESTORS, MATCH_BATCH,
    // YT_PAGES_PER_STEP, SCRUB_MAX_BYTES
}
