{
    "name": "aurora-music",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:all": "node scripts/dev.mjs",
        "test": "node --test",
        "build": "tsc -b && vite build",
        "typecheck": "tsc --noEmit -p tsconfig.app.json",
        "lint": "eslint .",
        "format": "prettier --write . --ignore-path .gitignore",
        "serve": "node server/src/index.js",
        "start": "npm run build && node server/src/index.js",
        "postinstall": "npm --prefix server install --omit=dev"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@fontsource-variable/inter": "^5.3.0",
        "@jellyfin/sdk": "^1.0.0",
        "@primer/octicons-react": "^19.38.0",
        "@tanstack/query-sync-storage-persister": "^5.103.2",
        "@tanstack/react-query": "^5.103.2",
        "@tanstack/react-query-persist-client": "^5.103.2",
        "@types/m3u8-parser": "^7.2.6",
        "@types/node": "^26.6.2",
        "axios": "^1.7.9",
        "figma-squircle": "^1.1.0",
        "hls.js": "^1.7.3",
        "m3u8-parser": "^7.2.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router-dom": "7.18.4",
        "react-virtuoso": "^4.18.15"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.11.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.12.0",
        "prettier": "^3.9.9",
        "typescript": "~6.0.0",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.1",
        "vite-plugin-pwa": "^1.3.0"
    },
    "engines": {
        "node": ">=20"
    },
    "description": "Reproductor de música familiar: app web + gateway Node que oculta el servidor de música detrás de un código y un panel de administración.",
    "license": "MIT"
}
