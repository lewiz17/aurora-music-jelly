# Copia a .env para docker compose
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contrasena
SESSION_SECRET=cadena-aleatoria-larga-de-64-caracteres
AURORA_PORT=8787
# Opcional: sólo para incrustar la app/panel en un iframe de otro origen (vistas previas).
# SANDBOX_ORIGIN=1
# Opcional: persistencia en Postgres (Neon, Supabase u otro). Si defines DATABASE_URL,
# el estado y los logos se guardan también en la base de datos. Sin esta variable todo
# funciona como siempre: aurora.json es el respaldo local y el fallback si la base cae.
# DATABASE_URL=postgres://usuario:password@host:5432/base?sslmode=require
