# Copia a deploy/oracle/.env (install.sh lo hace y genera las contraseñas por ti).
# Dominio con el que se entra a Aurora, SIN https://  (p. ej. musica.duckdns.org)
DOMAIN=musica.tudominio.com

ADMIN_USER=admin
# contraseña del panel /admin
ADMIN_PASSWORD=cambia-esto
# cadena aleatoria larga: openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-64-caracteres-aleatorios
